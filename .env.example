# ---------------------------------------------------------------------------
# QBR Narrator Agent — Environment Configuration
#
# BRING YOUR OWN KEYS: every key below is one YOU create on YOUR OWN account.
# This repo ships with NO author-owned credentials — nothing runs on the
# author's account and the author never sees your usage. Your keys live in a
# local `.env` file on your own machine (git-ignored, never committed).
#
# Fill in the values for the services you want to use. Each key is real and
# maps to a documented integration. NEVER commit real secrets — this file is a
# template only. Copy it to `.env` and fill it in locally.
#
# Where to get each value:
#   - Anthropic: console.anthropic.com > API Keys (needs Build Tier 1 prepaid credit)
#   - ElevenLabs: elevenlabs.io > Profile > API Key (needs Starter plan or higher)
#   - SendGrid: app.sendgrid.com > Settings > API Keys (free tier: 100 emails/day)
#   - Mailchimp: mailchimp.com > Account > Extras > API keys (Transactional)
#   - SMTP: your mail provider's SMTP host/user/password (Gmail app password, etc.)
# ---------------------------------------------------------------------------

# --- Anthropic Claude (deck text generation & tone analysis) ----------------
# Needs Build Tier 1 prepaid API credit ($5 minimum). This is an API key, NOT a
# Claude Pro web subscription.
ANTHROPIC_API_KEY=

# --- ElevenLabs (voice narration + optional Instant Voice Cloning) ----------
# Requires the Starter plan ($5/mo) or higher to unlock Instant Voice Cloning
# and commercial voice generation.
ELEVENLABS_API_KEY=

# Optional: override the default narrator voice and model.
# Leave blank to use the built-in Formal executive narrator voice.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Email adapters ---------------------------------------------------------
# Choose one: local (free mock), sendgrid, mailchimp, or smtp.
EMAIL_ADAPTER=local

# SendGrid (free tier: 100 emails/day)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Mailchimp Transactional
MAILCHIMP_API_KEY=
MAILCHIMP_FROM_EMAIL=

# SMTP (Gmail / Outlook / any provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Safety & budget guards -------------------------------------------------
# TEST_MODE=true keeps every run local (no real emails sent). Flip to false
# only when you are ready to dispatch.
TEST_MODE=true

# Hard ceiling on estimated cost per generated deck (USD). The agent refuses to
# run if the projected cost would exceed this. Protects against runaway spend.
MAX_COST_PER_DECK=0.50

# Where LocalMockAdapter writes decks, audio, and the checklist.
OUTPUT_DIR=./output
